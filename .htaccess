Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On
# Keep superseded catalog pagination URLs usable after the product review.
RewriteRule ^catalog/stand\-up\-pouches/page\-18/$ /catalog/stand-up-pouches/page-17/ [R=301,L,NE]
RewriteRule ^catalog/bags/page\-28/$ /catalog/bags/page-27/ [R=301,L,NE]
RewriteRule ^catalog/pouches/page\-26/$ /catalog/pouches/page-25/ [R=301,L,NE]
RewriteRule ^catalog/mailer\-shipping\-boxes/page\-13/$ /catalog/mailer-shipping-boxes/page-12/ [R=301,L,NE]
# Build sources and Git metadata are not public site content.
RewriteRule ^(?:tools|content|qa|\.git)(?:/|$) - [R=404,L,NC]
RewriteRule ^\.(?!well-known(?:/|$)) - [R=404,L,NC]
RewriteRule ^(?:README|DEPLOYMENT)\.md$ - [R=404,L,NC]
# Let a local Apache preview run without a production-domain redirect.
RewriteCond %{HTTP_HOST} ^(?:www\.)?packhubglobe\.com$ [NC]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\.packhubglobe\.com$ [NC]
RewriteRule ^ https://www.packhubglobe.com%{REQUEST_URI} [R=301,L]
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html(?:[?\s]) [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L,NE]
</IfModule>

<IfModule mod_headers.c>
# Filter combinations are shareable utilities, not additional indexable collections.
Header always set X-Robots-Tag "noindex, follow" "expr=%{REQUEST_URI} =~ m#^/catalog/# && %{QUERY_STRING} =~ m#(^|&)(q|industry|structure|material)=#"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
<FilesMatch "\.(?:html|xml|txt|json)$">
Header set Cache-Control "no-cache, max-age=0, must-revalidate"
</FilesMatch>
<FilesMatch "\.(?:webp|svg|woff2)$">
Header set Cache-Control "public, max-age=604800"
</FilesMatch>
</IfModule>

# Only content-addressed bundles receive immutable caching.
<IfModule mod_headers.c>
<FilesMatch "^site-[a-f0-9]{12}\.(?:css|js)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
</IfModule>
<IfModule mod_brotli.c>
AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
<IfModule !mod_brotli.c>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
</IfModule>
